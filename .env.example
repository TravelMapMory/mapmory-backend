# MapMory backend (run `go run ./cmd/server` from the repository root).
# The server reads these three keys from .env at startup. Explicitly exported
# environment variables take precedence. Firebase ADC is configured separately.
FIREBASE_PROJECT_ID=mapmory-development
# true enables BOTH application-user resolution and authenticated PostgreSQL trip routes.
# false retains PUBLIC in-memory prototype trips; do not use with private data.
MAPMORY_ENABLE_DB_USER_RESOLUTION=false
# Localhost-only PostgreSQL 17; see docs/application-user-resolution.md.
DATABASE_URL=postgres://mapmory:mapmory-local@127.0.0.1:5432/mapmory?sslmode=disable

# Test-only inputs for scripts/firebase-id-token.sh and VS Code requests.http.
# The Go backend DOES NOT import these into its environment.
# Use a disposable account. Do not commit .env or real secrets.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
TEST_EMAIL=replace-with-test-user-email
TEST_PASSWORD=replace-with-disposable-test-password
FIREBASE_ID_TOKEN=replace-with-temporary-firebase-id-token
