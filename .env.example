# Backend startup: export separately in the shell (Go does not load .env).
FIREBASE_PROJECT_ID=mapmory-development

# Manual Firebase Email/Password smoke test; read by commands in docs/firebase-auth-testing.md.
# Public web app configuration, not an Admin SDK credential.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

# Use only a disposable development account. TEST_PASSWORD is plaintext in local .env.
# Never commit .env, and never use a real user's password here.
TEST_EMAIL=replace-with-test-user-email
TEST_PASSWORD=replace-with-disposable-test-password

# Short-lived Firebase user ID token for VS Code REST Client (requests.http).
# Generated during the manual test; delete from .env after testing.
FIREBASE_ID_TOKEN=replace-with-temporary-firebase-id-token
