# MapMory backend — local development configuration.
# Copy this file to .env in the repository root; never commit .env.
# The Go server loads the server settings below from .env at startup.
# Explicitly exported shell environment variables take precedence.
# The Firebase test credentials near the bottom are NOT loaded by the Go server.
# Start the server from the repository root: go run ./cmd/server

# Firebase project used to verify signed-in users' ID tokens.
# Firebase Admin SDK credentials (ADC) are configured separately; this is NOT a credential.
FIREBASE_PROJECT_ID=mapmory-development

# Persistent user and trip/photo/sharing APIs.
# Set true for the real upload -> correct -> share workflow. This requires DATABASE_URL
# and a running PostgreSQL database with the latest Goose migrations applied.
# false runs the old PUBLIC in-memory trip prototype; never use it with private data.
MAPMORY_ENABLE_DB_USER_RESOLUTION=true

# Example for a localhost-only PostgreSQL 17 development container.
# Use your own local credentials; never commit real database passwords.
DATABASE_URL=postgres://mapmory:mapmory-local@127.0.0.1:5432/mapmory?sslmode=disable

# Photo storage provider: local (development only) or gcs (Google Cloud Storage).
# Local mode still uses real PostgreSQL records and Firebase authentication.
# It writes originals and processed display images to the directory below and
# serves expiring, signed upload/display URLs from the loopback-only Go server.
# Do not use the local filesystem provider for a public deployment.
MAPMORY_PHOTO_STORAGE=local

# Local mode only: directory for uploaded originals and processed display images.
# This directory is gitignored. Keep it on a private local filesystem.
MAPMORY_LOCAL_PHOTO_DIR=.local-photos

# GCS mode only: set MAPMORY_PHOTO_STORAGE=gcs, then configure the bucket.
# Leave the bucket EMPTY in local mode; startup rejects local mode otherwise.
# On a cloud deployment use a private bucket, never public photo URLs.
MAPMORY_PHOTO_BUCKET=

# GCS mode only: service account used for photo storage and signed URL creation.
# Local ADC may require Service Account Token Creator permission; see deploy/README.md.
# Leave empty in local mode and on the VM if the runtime account signs URLs itself.
MAPMORY_UPLOAD_SIGNER=

# Optional Geoapify server-side key for place search and automatic photo labels.
# Never place this secret in frontend configuration. Without it, photos can still
# be uploaded and browsed, but place search is unavailable and labels may be pending.
GEOAPIFY_API_KEY=

# --- Manual Firebase Email/Password smoke test ---
# The following values are read by scripts/firebase-id-token.sh and
# docs/firebase-auth-testing.md; they are NOT imported into the Go server.
# FIREBASE_WEB_API_KEY is public web app configuration, not an Admin SDK credential.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

# Use only a disposable development account. TEST_PASSWORD is plaintext in local .env.
# Never commit .env, and never use a real user's password here.
TEST_EMAIL=replace-with-test-user-email
TEST_PASSWORD=replace-with-disposable-test-password

# Short-lived Firebase user ID token for VS Code REST Client (requests.http).
# Created or updated by scripts/firebase-id-token.sh after you prepare .env yourself.
# The helper never creates .env. Restrict permissions: chmod 600 .env.
# Remove the token from .env after testing.
FIREBASE_ID_TOKEN=
